# Скопируйте в .env и заполните (setup-server.sh делает это сам со случайными секретами).
# Файл .env в git не попадает.

# Адрес сайта. Без своего домена: crm.<IP-сервера>.sslip.io
CRM_DOMAIN=crm.203.0.113.10.sslip.io

# Пароль базы данных
POSTGRES_PASSWORD=change-me

# Ключ подписи токенов, не короче 32 символов
CRM_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Суперадминистратор платформы (создаётся при первом запуске)
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=change-me
CRM_ADMIN_NAME="Администратор CRM"
